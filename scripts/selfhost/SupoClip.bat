@echo off
setlocal EnableExtensions
title SupoClip - Port 1978 Self-Heal und Auto-Updater

net session >nul 2>&1
if errorlevel 1 (
    echo Starte SupoClip mit Administrator-Rechten...
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

if not exist "C:\SupoClip" mkdir "C:\SupoClip"
if not exist "C:\SupoClip\logs" mkdir "C:\SupoClip\logs"
if /i not "%~f0"=="C:\SupoClip\SupoClip.bat" (
    copy /y "%~f0" "C:\SupoClip\SupoClip.bat" >nul 2>&1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$p = '::' + 'B64:'; $b64 = (Get-Content -LiteralPath 'C:\SupoClip\SupoClip.bat' | Where-Object { $_.StartsWith($p) } | ForEach-Object { $_.Substring(6) }) -join ''; [System.IO.File]::WriteAllBytes('C:\SupoClip\supoclip_selfheal.ps1', [System.Convert]::FromBase64String($b64))"
if errorlevel 1 (
    echo [FEHLER] Konnte supoclip_selfheal.ps1 nicht entpacken.
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "C:\SupoClip\supoclip_selfheal.ps1"
echo.
pause
exit /b 0

